# Dependencies
node_modules/

# Build output
build/
dist/

# Tauri: Rust build artefacts, and the schemas Tauri regenerates on every build.
# gen/android is deliberately NOT ignored — it is the Gradle project, carries
# the manifest and the signing configuration, and CI has no way to rebuild it.
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/gen/android/.gradle/
src-tauri/gen/android/app/build/
src-tauri/gen/android/build/
src-tauri/gen/android/local.properties

# Android signing: the key and its passwords are credentials, not source.
src-tauri/gen/android/keystore.properties
src-tauri/gen/android/*.keystore

# Test and coverage artifacts
coverage/
test-results/
playwright-report/
blob-report/

# Caches
.vite/
.cache/
*.tsbuildinfo

# Local environment files (bun.lock is committed on purpose — it is the
# project's lockfile and the SessionStart hook installs from it)
.env
.env.*
*.local

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Local scratch: third-party material kept next to the project for reference
# only (builds, installers), never part of this repository.
.0Zeiterfassungs-App von Flo/

# Logs
*.log
npm-debug.log*
yarn-error.log*
